    {"id": "r-compare-patients", "question": "Compare PT-001 and PT-004's acne plans.", "expect_status": ["answered", "partial"], "must_cite": ["PT-001", "PT-004"], "expect_parts": 2, "must_mention": ["2 weeks|staged", "6 weeks|active acne"]},
    {"id": "r-sensitive-skin", "question": "Which patient reports sensitive skin and trouble following multi-step routines?", "expect_status": ["answered", "partial"], "must_cite": ["PT-008"], "must_mention": ["PT-008"], "must_not_cite": ["PT-001", "PT-002", "PT-003", "PT-004", "PT-005", "PT-006", "PT-007"]},

    {"id": "t-a1", "conversation": "chain-a", "question": "What did PT-005 come in for?", "expect_status": ["answered", "partial"], "must_cite": ["PT-005"], "must_mention": ["lower-face|volume|contour"]},
